# RapidAPI Key (Zillow API アクセス用)
# https://rapidapi.com/apimaker/api/zillow-com1 で取得
RAPIDAPI_KEY=your_rapidapi_key_here

# Google Maps Platform API Key
# https://console.cloud.google.com/ で取得
# 有効にするAPI: Geocoding, Places, Roads
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Anthropic API Key
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# FRED API Key (住宅ローン金利データ)
# https://fred.stlouisfed.org/docs/api/api_key.html で無料登録
FRED_API_KEY=your_fred_api_key_here

# US Census Bureau API Key (人口統計・所得・住宅データ)
# https://api.census.gov/data/key_signup.html で無料登録
CENSUS_API_KEY=your_census_api_key_here

# HUD API Token (公正市場賃料 Fair Market Rents)
# https://www.huduser.gov/portal/dataset/fmr-api.html で無料登録
HUD_API_TOKEN=your_hud_api_token_here

# Walk Score API Key (徒歩・交通・自転車スコア)
# https://www.walkscore.com/professional/api.php で無料登録
WALKSCORE_API_KEY=your_walkscore_api_key_here

# FBI Crime Data Explorer API Key (全米犯罪データ — TX・IL等すべての都市対応)
# https://api.usa.gov/crime/fbi/sapi/ で無料登録
FBI_API_KEY=your_fbi_api_key_here
